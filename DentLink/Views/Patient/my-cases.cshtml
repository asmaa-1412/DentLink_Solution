<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - My Cases</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
        <div class="space-y-8">
            <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2 cursor-pointer" onclick="window.location.href='patient-dashboard.html'">
                <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>

            </div>
            <div class="px-2"><span class="text-[10px] tracking-wider font-bold text-[#2563EB] bg-[#EFF6FF] px-2.5 py-1 rounded-md uppercase">Patient</span></div>
            <nav class="space-y-1">
                <a href="patient-dashboard.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-table-columns text-sm w-5"></i><span>Dashboard</span>
                </a>
                <a href="my-cases.html" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                    <i class="fa-regular fa-folder-open text-sm w-5"></i><span>My Cases</span>
                </a>
                <a href="add-case.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-plus text-sm w-5"></i><span>Add Case</span>
                </a>
                <a href="requests.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-envelope text-sm w-5"></i><span>Requests</span>
                </a>
                <a href="profile.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-user text-sm w-5"></i><span>Profile</span>
                </a>
            </nav>
        </div>
        <div class="border-t border-slate-100 pt-4 space-y-3">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-2">
                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100" class="w-8 h-8 rounded-full object-cover">
                    <div>
                        <h4 class="text-xs font-bold text-slate-800">Sara Mohamed</h4>
                        <p class="text-[10px] text-slate-400 font-medium">Patient</p>
                    </div>
                </div>
            </div>
            <button onclick="window.location.href='../auth/login.html'" class="flex items-center gap-3 w-full px-3 py-2 text-slate-400 hover:text-rose-600 font-semibold text-xs rounded-xl transition">
                <i class="fa-solid fa-arrow-right-from-bracket text-sm w-5"></i><span>Logout</span>
            </button>
        </div>
    </aside>

    <!-- MAIN MAIN AREA -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
            <h2 class="text-sm font-bold text-slate-800">My Cases</h2>
            <div class="flex items-center gap-4">
                <button class="text-slate-400 hover:text-slate-600 relative p-1.5">
                    <i class="fa-regular fa-bell text-lg"></i><span class="absolute top-1 right-1.5 w-1.5 h-1.5 bg-rose-500 rounded-full"></span>
                </button>
                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100" class="w-8 h-8 rounded-full object-cover">
            </div>
        </header>

        <main class="flex-1 px-8 py-8 space-y-6 max-w-6xl w-full">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-xl font-bold text-slate-900">My Cases</h1>
                    <p class="text-xs text-slate-400 font-medium mt-1">All your submitted dental cases</p>
                </div>
                <button onclick="window.location.href='add-case.html'" class="bg-[#2563EB] text-white font-semibold text-xs px-4 py-2.5 rounded-xl hover:bg-blue-700 transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-plus"></i> New Case
                </button>
            </div>

            <!-- List of Cases -->
            <div class="space-y-3">
                <!-- Case 1 -->
                <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-4">
                        <img src="https://images.unsplash.com/photo-1606811841689-23dfddce3e95?auto=format&fit=crop&q=80&w=150" class="w-12 h-12 rounded-xl object-cover">
                        <div>
                            <h4 class="text-sm font-bold text-slate-800">Filling</h4>
                            <p class="text-[11px] text-slate-400 font-medium mt-0.5">Upper molar cavity with mild pain on chewing</p>
                            <span class="text-[10px] text-slate-400 font-medium block mt-1">Jun 15, 2026</span>
                        </div>
                    </div>
                    <div class="text-right space-y-2">
                        <span class="text-[10px] font-bold bg-amber-50 text-amber-600 px-2.5 py-0.5 rounded-full">pending</span>
                        <p onclick="window.location.href='requests.html'" class="text-[11px] font-semibold text-[#2563EB] cursor-pointer hover:underline">2 student requests</p>
                    </div>
                </div>
                <!-- Case 2 -->
                <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-4">
                        <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=150" class="w-12 h-12 rounded-xl object-cover">
                        <div>
                            <h4 class="text-sm font-bold text-slate-800">Cleaning</h4>
                            <p class="text-[11px] text-slate-400 font-medium mt-0.5">Routine scaling and polishing session</p>
                            <span class="text-[10px] text-slate-400 font-medium block mt-1">May 20, 2026</span>
                        </div>
                    </div>
                    <div class="text-right"><span class="text-[10px] font-bold bg-emerald-50 text-emerald-600 px-2.5 py-0.5 rounded-full">completed</span></div>
                </div>
                <!-- Case 3 -->
                <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-4">
                        <img src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&q=80&w=150" class="w-12 h-12 rounded-xl object-cover">
                        <div>
                            <h4 class="text-sm font-bold text-slate-800">Extraction</h4>
                            <p class="text-[11px] text-slate-400 font-medium mt-0.5">Wisdom tooth (lower right) causing pain and swelling</p>
                            <span class="text-[10px] text-slate-400 font-medium block mt-1">Jun 18, 2026</span>
                        </div>
                    </div>
                    <div class="text-right space-y-2">
                        <span class="text-[10px] font-bold bg-blue-50 text-blue-600 px-2.5 py-0.5 rounded-full">active</span>
                        <p onclick="window.location.href='requests.html'" class="text-[11px] font-semibold text-[#2563EB] cursor-pointer hover:underline">3 student requests</p>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>