@model DentLink.BusinessLogicLayer.DTOs.PatientDTOs.CreateCaseDto
@{
    Layout = null;
    int patientId = (int)(ViewBag.PatientId ?? 0);
    string patientName = ViewBag.PatientName ?? "Patient";
    string patientImageUrl = ViewBag.PatientImageUrl ?? "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100";
    var caseTypes = ViewBag.CaseTypes as IEnumerable<DentLink.DataAccessLayer.Enums.Typies>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Create Dental Case</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

    <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
        <div class="space-y-8">
            <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2 cursor-pointer" onclick="window.location.href='@Url.Action("PatientDashboard", "Sessions")'">
                <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
            </div>
            <div class="px-2">
                <span class="text-[10px] tracking-wider font-bold text-[#2563EB] bg-[#EFF6FF] px-2.5 py-1 rounded-md uppercase">Patient</span>
            </div>
            <nav class="space-y-1">
                <a href="@Url.Action("PatientDashboard", "Sessions")" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-table-columns text-sm w-5"></i><span>Dashboard</span>
                </a>
                <a href="@Url.Action("MyCases", "Cases", new { id = patientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-folder-open text-sm w-5"></i><span>My Cases</span>
                </a>
                <a href="@Url.Action("Create", "Cases", new { patientId = patientId })" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                    <i class="fa-solid fa-plus text-sm w-5"></i><span>Add Case</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-envelope text-sm w-5"></i><span>Requests</span>
                </a>
                <a href="@Url.Action("Profile", "Patients", new { id = patientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-user text-sm w-5"></i><span>Profile</span>
                </a>
            </nav>
        </div>
        <div class="border-t border-slate-100 pt-4 space-y-3">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-2">
                    <img src="@patientImageUrl" class="w-8 h-8 rounded-full object-cover">
                    <div>
                        <h4 class="text-xs font-bold text-slate-800">@patientName</h4>
                        <p class="text-[10px] text-slate-400 font-medium">Patient</p>
                    </div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="flex items-center gap-3 w-full px-3 py-2 text-slate-400 hover:text-rose-600 font-semibold text-xs rounded-xl transition">
                    <i class="fa-solid fa-arrow-right-from-bracket text-sm w-5"></i><span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
            <h2 class="text-sm font-bold text-slate-800">Add Case</h2>
        </header>

        <main class="flex-1 px-8 py-8 max-w-3xl w-full">
            <div class="mb-6">
                <h1 class="text-xl font-bold text-slate-900">Create Dental Case</h1>
                <p class="text-xs text-slate-400 font-medium mt-1">Describe your dental concern so we can find the right student for you.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-rose-50 border border-rose-100 text-rose-600 rounded-xl p-3 mb-4 text-xs font-medium">
                    Please check the form fields and try again.
                </div>
            }

            <form asp-controller="Cases" asp-action="Create" method="post" enctype="multipart/form-data" class="bg-white border border-slate-100 rounded-2xl p-6 shadow-sm space-y-5">

                <input type="hidden" name="PatientId" value="@patientId" />

                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-slate-700">Case Type *</label>
                    <select name="CaseType" required class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-xs text-slate-600 focus:outline-none focus:border-blue-500 transition">
                        <option value="" disabled selected>Select procedure type</option>
                        @if (caseTypes != null)
                        {
                            foreach (var t in caseTypes)
                            {
                                <option value="@((int)t)">@t</option>
                            }
                        }
                    </select>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-slate-700">Case Description *</label>
                    <textarea name="Description" required rows="4" placeholder="Describe your symptoms, when they started, and any relevant medical history or previous treatments..." class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-xs placeholder:text-slate-300 focus:outline-none focus:border-blue-500 transition resize-none"></textarea>
                </div>

                <div class="space-y-1.5">
                    <label class="text-xs font-bold text-slate-700">Upload Dental Image (optional)</label>
                    <div class="border border-dashed border-slate-200 rounded-xl p-8 text-center bg-slate-50/50 cursor-pointer hover:bg-slate-50 transition relative">
                        <input type="file" name="DentalImage" accept=".jpg,.jpeg,.png,.pdf" class="absolute inset-0 opacity-0 cursor-pointer">
                        <i class="fa-solid fa-upload text-blue-500 text-lg mb-2"></i>
                        <p class="text-xs font-semibold text-slate-700">Drop your X-ray or photo here</p>
                        <p class="text-[10px] text-slate-400 mt-0.5">or <span class="text-blue-600 underline">browse files</span> - JPG, PNG, PDF</p>
                    </div>
                </div>

                <div class="bg-blue-50/60 text-[#2563EB] rounded-xl p-3 flex gap-2.5 items-start">
                    <i class="fa-solid fa-circle-info text-xs mt-0.5"></i>
                    <p class="text-[10px] font-medium leading-normal">Your case will be reviewed and matched with a verified dental student within 24–48 hours. You will receive a notification once a student applies.</p>
                </div>

                <button type="submit" class="w-full bg-[#2563EB] text-white py-3 rounded-xl font-bold text-xs hover:bg-blue-700 transition shadow-md flex items-center justify-center gap-1">
                    Submit Case <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </button>
            </form>
        </main>
    </div>
</body>
</html>