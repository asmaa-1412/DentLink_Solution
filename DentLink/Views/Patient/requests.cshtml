@model List<DentLink.BusinessLogicLayer.DTOs.PatientDTOs.PatientCaseRequestDto>
@{
    Layout = null;
    int patientId = (int)(ViewBag.PatientId ?? 0);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Student Requests</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }</style>
    </head>
    <body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

        <!-- SIDEBAR -->
        <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
            <div class="space-y-8">
                <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2 cursor-pointer" onclick="window.location.href='@Url.Action("PatientDashboard", "Sessions")'">
                    <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
                </div>
                <div class="px-2"><span class="text-[10px] tracking-wider font-bold text-[#2563EB] bg-[#EFF6FF] px-2.5 py-1 rounded-md uppercase">Patient</span></div>
                <nav class="space-y-1">
                    <a href="@Url.Action("PatientDashboard", "Sessions")" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                        <i class="fa-solid fa-table-columns text-sm w-5"></i><span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("MyCases", "Cases", new { id = patientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                        <i class="fa-regular fa-folder-open text-sm w-5"></i><span>My Cases</span>
                    </a>
                    <a href="@Url.Action("Create", "Cases", new { patientId = patientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                        <i class="fa-solid fa-plus text-sm w-5"></i><span>Add Case</span>
                    </a>
                    <a href="@Url.Action("MyRequests", "Requests", new { patientId = patientId })" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                        <i class="fa-regular fa-envelope text-sm w-5"></i><span>Requests</span>
                    </a>
                    <a href="@Url.Action("Profile", "Patients", new { id = patientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                        <i class="fa-regular fa-user text-sm w-5"></i><span>Profile</span>
                    </a>
                </nav>
            </div>
            <div class="border-t border-slate-100 pt-4 space-y-3">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="flex items-center gap-3 w-full px-3 py-2 text-slate-400 hover:text-rose-600 font-semibold text-xs rounded-xl transition">
                        <i class="fa-solid fa-arrow-right-from-bracket text-sm w-5"></i><span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN AREA -->
        <div class="flex-1 flex flex-col min-w-0">
            <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
                <h2 class="text-sm font-bold text-slate-800">Requests</h2>
            </header>

            <main class="flex-1 px-8 py-8 space-y-6 max-w-7xl w-full">
                <div>
                    <h1 class="text-xl font-bold text-slate-900">Student Requests</h1>
                    <p class="text-xs text-slate-400 font-medium mt-1">Dental students who have applied to treat your cases</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="bg-emerald-50 border border-emerald-100 text-emerald-700 rounded-xl p-3 flex items-center gap-2.5 text-xs font-medium">
                        <i class="fa-regular fa-circle-check text-emerald-500 text-sm"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="bg-rose-50 border border-rose-100 text-rose-700 rounded-xl p-3 flex items-center gap-2.5 text-xs font-medium">
                        <i class="fa-regular fa-circle-xmark text-rose-500 text-sm"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                @if (Model != null && Model.Any())
                {
                    var groupedByCase = Model.GroupBy(r => new { r.CaseId, r.CaseType, r.CaseDescription });

                    foreach (var group in groupedByCase)
                    {
                        <div class="space-y-3">
                            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                                @group.Key.CaseType — <span class="normal-case font-medium text-slate-400">@group.Key.CaseDescription</span>
                            </h3>

                            <div class="grid md:grid-cols-3 gap-6">
                                @foreach (var r in group)
                                {
                                    var initials = string.Join("", (r.DoctorName ?? "?").Split(' ').Where(s => s.Length > 0).Select(s => s[0])).ToUpper();
                                    bool isAccepted = r.Status == "Active";
                                    bool isRejected = r.Status == "Cancelled";

                                    <div class="bg-white border @(isAccepted ? "border-emerald-200 ring-1 ring-emerald-100" : "border-slate-100") rounded-2xl p-5 shadow-sm space-y-4 relative @(isRejected ? "opacity-40" : "")">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xs">@initials</div>
                                                <div>
                                                    <h3 class="text-xs font-bold text-slate-800">@r.DoctorName</h3>
                                                </div>
                                            </div>
                                            @if (isAccepted)
                                            {
                                                <span class="text-[10px] font-bold bg-emerald-50 text-emerald-600 px-2.5 py-0.5 rounded-full">Accepted</span>
                                            }
                                            else if (isRejected)
                                            {
                                                <span class="text-[10px] font-bold bg-rose-50 text-rose-600 px-2.5 py-0.5 rounded-full">Rejected</span>
                                            }
                                        </div>
                                        <div class="space-y-1.5 text-[11px] font-medium text-slate-400">
                                            <div class="flex items-center gap-2"><i class="fa-solid fa-building-columns text-slate-300 w-4"></i>@r.University</div>
                                            <div class="flex items-center gap-2"><i class="fa-solid fa-stethoscope text-slate-300 w-4"></i>@r.Department</div>
                                            <div class="flex items-center gap-2"><i class="fa-regular fa-clock text-slate-300 w-4"></i>@r.AcademicYear</div>
                                            <div class="flex items-center gap-2"><i class="fa-solid fa-car text-slate-300 w-4"></i>Transportation: EGP @r.TransportCost</div>
                                        </div>

                                        @if (r.Status == "Pending")
                                        {
                                            <div class="grid grid-cols-2 gap-2 pt-2">
                                                <form asp-controller="Requests" asp-action="AcceptRequest" method="post">
                                                    <input type="hidden" name="requestId" value="@r.RequestId" />
                                                    <input type="hidden" name="patientId" value="@patientId" />
                                                    <button type="submit" class="w-full bg-[#2563EB] text-white font-bold text-[11px] py-2 rounded-xl hover:bg-blue-700 transition">Accept</button>
                                                </form>
                                                <form asp-controller="Requests" asp-action="RejectRequest" method="post">
                                                    <input type="hidden" name="requestId" value="@r.RequestId" />
                                                    <input type="hidden" name="patientId" value="@patientId" />
                                                    <button type="submit" class="w-full border border-slate-100 text-slate-400 font-bold text-[11px] py-2 rounded-xl hover:bg-slate-50 transition">Reject</button>
                                                </form>
                                            </div>
                                        }
                                        else if (isAccepted)
                                        {
                                            <div class="pt-2">
                                                <div class="bg-emerald-50 text-emerald-600 font-bold text-[11px] py-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                                                    <i class="fa-solid fa-check text-xs"></i> Request Accepted
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="bg-white border border-slate-100 rounded-2xl py-16 text-center space-y-2">
                        <i class="fa-regular fa-envelope text-slate-300 text-3xl"></i>
                        <p class="text-xs font-medium text-slate-400">No student requests yet.</p>
                    </div>
                }
            </main>
        </div>
    </body>
</html>