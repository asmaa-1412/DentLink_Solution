<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Student Requests</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }</style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
        <div class="space-y-8">
            <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2 cursor-pointer" onclick="window.location.href='patient-dashboard.html'">
                <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
            </div>
            <div class="px-2"><span class="text-[10px] tracking-wider font-bold text-[#2563EB] bg-[#EFF6FF] px-2.5 py-1 rounded-md uppercase">Patient</span></div>
            <nav class="space-y-1">
                <a href="patient-dashboard.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-table-columns text-sm w-5"></i><span>Dashboard</span>
                </a>
                <a href="my-cases.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-folder-open text-sm w-5"></i><span>My Cases</span>
                </a>
                <a href="add-case.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-plus text-sm w-5"></i><span>Add Case</span>
                </a>
                <a href="requests.html" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                    <i class="fa-regular fa-envelope text-sm w-5"></i><span>Requests</span>
                </a>
                <a href="profile.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-user text-sm w-5"></i><span>Profile</span>
                </a>
            </nav>
        </div>
        <div class="border-t border-slate-100 pt-4 space-y-3">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-2">
                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100" class="w-8 h-8 rounded-full object-cover">
                    <div><h4 class="text-xs font-bold text-slate-800">Sara Mohamed</h4><p class="text-[10px] text-slate-400 font-medium">Patient</p></div>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN AREA -->
    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
            <h2 class="text-sm font-bold text-slate-800">Requests</h2>
        </header>

        <main class="flex-1 px-8 py-8 space-y-6 max-w-7xl w-full">
            <div>
                <h1 class="text-xl font-bold text-slate-900">Student Requests</h1>
                <p class="text-xs text-slate-400 font-medium mt-1">Dental students who have applied to treat your case</p>
            </div>

            <!-- Success Alert Banner (Hidden by default, matches image_eba120.jpg) -->
            <div id="successAlert" class="hidden bg-emerald-50 border border-emerald-100 text-emerald-700 rounded-xl p-3 flex items-center gap-2.5 text-xs font-medium transition-all duration-300">
                <i class="fa-regular fa-circle-check text-emerald-500 text-sm"></i>
                <span>Request accepted! The student will be notified and will contact you shortly.</span>
            </div>

            <!-- Grid of Student Profiles -->
            <div class="grid md:grid-cols-3 gap-6 transition-all duration-300" id="requestsGrid">

                <!-- Student 1: Omar Khaled -->
                <div id="card-omar" class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm space-y-4 relative transition-all duration-300">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&q=80&w=100" class="w-10 h-10 rounded-full object-cover">
                            <div>
                                <h3 class="text-xs font-bold text-slate-800">Omar Khaled</h3>
                                <div class="text-[10px] text-amber-500 font-bold mt-0.5"><i class="fa-solid fa-star text-[9px]"></i> 4.8</div>
                            </div>
                        </div>
                        <!-- Top Badge Hidden by default -->
                        <span id="badge-omar" class="hidden text-[10px] font-bold bg-emerald-50 text-emerald-600 px-2.5 py-0.5 rounded-full">Accepted</span>
                    </div>
                    <div class="space-y-1.5 text-[11px] font-medium text-slate-400">
                        <div class="flex items-center gap-2"><i class="fa-solid fa-building-columns text-slate-300 w-4"></i>Cairo University</div>
                        <div class="flex items-center gap-2"><i class="fa-solid fa-stethoscope text-slate-300 w-4"></i>Faculty of Dentistry</div>
                        <div class="flex items-center gap-2"><i class="fa-regular fa-clock text-slate-300 w-4"></i>4th Year</div>
                        <div class="flex items-center gap-2"><i class="fa-solid fa-car text-slate-300 w-4"></i>Transportation: EGP 50</div>
                    </div>
                    <!-- Action Area -->
                    <div id="actions-omar" class="grid grid-cols-2 gap-2 pt-2">
                        <button onclick="acceptStudent('omar')" class="bg-[#2563EB] text-white font-bold text-[11px] py-2 rounded-xl hover:bg-blue-700 transition">Accept</button>
                        <button onclick="rejectStudent('omar')" class="border border-slate-100 text-slate-400 font-bold text-[11px] py-2 rounded-xl hover:bg-slate-50 transition">Reject</button>
                    </div>
                    <!-- Bottom Big Button Hidden by default -->
                    <div id="status-omar" class="hidden pt-2">
                        <div class="bg-emerald-50 text-emerald-600 font-bold text-[11px] py-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-check text-xs"></i> Request Accepted
                        </div>
                    </div>
                </div>

                <!-- Student 2: Nour Ibrahim -->
                <div id="card-nour" class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm space-y-4 relative transition-all duration-300">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=100" class="w-10 h-10 rounded-full object-cover">
                            <div>
                                <h3 class="text-xs font-bold text-slate-800">Nour Ibrahim</h3>
                                <div class="text-[10px] text-amber-500 font-bold mt-0.5"><i class="fa-solid fa-star text-[9px]"></i> 4.9</div>
                            </div>
                        </div>
                        <span id="badge-nour" class="hidden text-[10px] font-bold bg-emerald-50 text-emerald-600 px-2.5 py-0.5 rounded-full">Accepted</span>
                    </div>
                    <div class="space-y-1.5 text-[11px] font-medium text-slate-400">
                        <div class="flex items-center gap-2"><i class="fa-solid fa-building-columns text-slate-300 w-4"></i>Ain Shams University</div>
                        <div class="flex items-center gap-2"><i class="fa-solid fa-stethoscope text-slate-300 w-4"></i>Faculty of Dentistry</div>
                        <div class="flex items-center gap-2"><i class="fa-regular fa-clock text-slate-300 w-4"></i>5th Year</div>
                        <div class="flex items-center gap-2"><i class="fa-solid fa-car text-slate-300 w-4"></i>Transportation: EGP 30</div>
                    </div>
                    <div id="actions-nour" class="grid grid-cols-2 gap-2 pt-2">
                        <button onclick="acceptStudent('nour')" class="bg-[#2563EB] text-white font-bold text-[11px] py-2 rounded-xl hover:bg-blue-700 transition">Accept</button>
                        <button onclick="rejectStudent('nour')" class="border border-slate-100 text-slate-400 font-bold text-[11px] py-2 rounded-xl hover:bg-slate-50 transition">Reject</button>
                    </div>
                    <div id="status-nour" class="hidden pt-2">
                        <div class="bg-emerald-50 text-emerald-600 font-bold text-[11px] py-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-check text-xs"></i> Request Accepted
                        </div>
                    </div>
                </div>

                <!-- Student 3: Youssef Ali -->
                <div id="card-youssef" class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm space-y-4 relative transition-all duration-300">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=100" class="w-10 h-10 rounded-full object-cover">
                            <div>
                                <h3 class="text-xs font-bold text-slate-800">Youssef Ali</h3>
                                <div class="text-[10px] text-amber-500 font-bold mt-0.5"><i class="fa-solid fa-star text-[9px]"></i> 4.6</div>
                            </div>
                        </div>
                        <span id="badge-youssef" class="hidden text-[10px] font-bold bg-emerald-50 text-emerald-600 px-2.5 py-0.5 rounded-full">Accepted</span>
                    </div>
                    <div class="space-y-1.5 text-[11px] font-medium text-slate-400">
                        <div class="flex items-center gap-2"><i class="fa-solid fa-building-columns text-slate-300 w-4"></i>Alexandria University</div>
                        <div class="flex items-center gap-2"><i class="fa-solid fa-stethoscope text-slate-300 w-4"></i>Faculty of Dentistry</div>
                        <div class="flex items-center gap-2"><i class="fa-regular fa-clock text-slate-300 w-4"></i>3rd Year</div>
                        <div class="flex items-center gap-2"><i class="fa-solid fa-car text-slate-300 w-4"></i>Transportation: EGP 70</div>
                    </div>
                    <div id="actions-youssef" class="grid grid-cols-2 gap-2 pt-2">
                        <button onclick="acceptStudent('youssef')" class="bg-[#2563EB] text-white font-bold text-[11px] py-2 rounded-xl hover:bg-blue-700 transition">Accept</button>
                        <button onclick="rejectStudent('youssef')" class="border border-slate-100 text-slate-400 font-bold text-[11px] py-2 rounded-xl hover:bg-slate-50 transition">Reject</button>
                    </div>
                    <div id="status-youssef" class="hidden pt-2">
                        <div class="bg-emerald-50 text-emerald-600 font-bold text-[11px] py-2.5 rounded-xl text-center flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-check text-xs"></i> Request Accepted
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- JAVASCRIPT LOGIC TO SIMULATE FIGMA INTERACTION -->
    <script>
        function acceptStudent(studentId) {
            // 1. Show the success banner at the top
            document.getElementById('successAlert').classList.remove('hidden');

            // 2. Modify the selected student's card style (Green Border)
            const card = document.getElementById(`card-${studentId}`);
            card.classList.remove('border-slate-100');
            card.classList.add('border-emerald-200', 'ring-1', 'ring-emerald-100');

            // 3. Show the Top Accepted Badge & Bottom Status Button
            document.getElementById(`badge-${studentId}`).classList.remove('hidden');
            document.getElementById(`status-${studentId}`).classList.remove('hidden');

            // 4. Hide the original Accept/Reject action buttons
            document.getElementById(`actions-${studentId}`).classList.add('hidden');

            // 5. Hide other student cards to match image_eba120.jpg (e.g. Nour gets filtered out if Omar is chosen)
            const allStudents = ['omar', 'nour', 'youssef'];
            allStudents.forEach(id => {
                if (id !== studentId) {
                    // We can either hide them or simulate filtering out. Let's hide 'nour' as per image_eba120.jpg
                    if(studentId === 'omar' && id === 'nour') {
                        document.getElementById(`card-${id}`).classList.add('hidden');
                    }
                }
            });
        }

        function rejectStudent(studentId) {
            // Smoothly hide the card when rejected
            const card = document.getElementById(`card-${studentId}`);
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            setTimeout(() => {
                card.classList.add('hidden');
            }, 300);
        }
    </script>
</body>
</html>