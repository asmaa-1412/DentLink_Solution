@model DentLink.BusinessLogicLayer.DTOs.PatientDTOs.PatientDashboardDto
@{
    Layout = null;
    var firstName = (Model.PatientName ?? "Patient").Split(' ')[0];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Patient Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

    <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
        <div class="space-y-8">
            <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2 cursor-pointer" onclick="window.location.href='@Url.Action("PatientDashboard", "Sessions")'">
                <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
            </div>

            <div class="px-2">
                <span class="text-[10px] tracking-wider font-bold text-[#2563EB] bg-[#EFF6FF] px-2.5 py-1 rounded-md uppercase">
                    Patient
                </span>
            </div>

            <nav class="space-y-1">
                <a href="@Url.Action("PatientDashboard", "Sessions")" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                    <i class="fa-solid fa-table-columns text-sm w-5"></i>
                    <span>Dashboard</span>
                </a>
                <a href="@Url.Action("MyCases", "Cases", new { id = Model.PatientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-folder-open text-sm w-5"></i>
                    <span>My Cases</span>
                </a>
                <a href="@Url.Action("Create", "Cases", new { patientId = Model.PatientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-plus text-sm w-5"></i>
                    <span>Add Case</span>
                </a>
                <a href="#" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-envelope text-sm w-5"></i>
                    <span>Requests</span>
                </a>
                <a href="@Url.Action("Profile", "Patients", new { id = Model.PatientId })" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-user text-sm w-5"></i>
                    <span>Profile</span>
                </a>
            </nav>
        </div>

        <div class="border-t border-slate-100 pt-4 space-y-3">
            <div class="flex items-center justify-between px-2">
                <div class="flex items-center gap-2">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100" : Model.ImageUrl)"
                         alt="Profile" class="w-8 h-8 rounded-full object-cover">
                    <div>
                        <h4 class="text-xs font-bold text-slate-800">@Model.PatientName</h4>
                        <p class="text-[10px] text-slate-400 font-medium">Patient</p>
                    </div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="flex items-center gap-3 w-full px-3 py-2 text-slate-400 hover:text-rose-600 font-semibold text-xs rounded-xl transition">
                    <i class="fa-solid fa-arrow-right-from-bracket text-sm w-5"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <div class="flex-1 flex flex-col min-w-0">
        <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
            <h2 class="text-sm font-bold text-slate-800">Dashboard</h2>
        </header>

        <main class="flex-1 px-8 py-8 space-y-8 max-w-6xl w-full">

            <div class="space-y-1">
                <h1 class="text-xl font-bold text-slate-900">Welcome back, @firstName</h1>
                <p class="text-xs text-slate-400 font-medium">Here's an overview of your dental cases.</p>
            </div>

            <div class="grid sm:grid-cols-3 gap-6">
                <div class="bg-white border border-slate-100 rounded-2xl p-5 flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-[#EFF6FF] text-[#2563EB] flex items-center justify-center text-lg">
                        <i class="fa-regular fa-folder"></i>
                    </div>
                    <div>
                        <div class="flex items-baseline gap-2">
                            <span class="text-2xl font-bold text-slate-900">@Model.MyCasesCount</span>
                            <span class="text-xs font-bold text-slate-800">My Cases</span>
                        </div>
                        <p class="text-[10px] text-slate-400 font-medium mt-0.5">
                            @Model.ActiveCasesCount active, @Model.CompletedCasesCount completed
                        </p>
                    </div>
                </div>

                <div class="bg-white border border-slate-100 rounded-2xl p-5 flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-[#EFF6FF] text-[#2563EB] flex items-center justify-center text-lg">
                        <i class="fa-regular fa-envelope"></i>
                    </div>
                    <div>
                        <div class="flex items-baseline gap-2">
                            <span class="text-2xl font-bold text-slate-900">@Model.PendingRequestsCount</span>
                            <span class="text-xs font-bold text-slate-800">Pending Requests</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-slate-100 rounded-2xl p-5 flex items-center gap-4 shadow-sm">
                    <div class="w-12 h-12 rounded-xl bg-[#EFF6FF] text-[#2563EB] flex items-center justify-center text-lg">
                        <i class="fa-regular fa-circle-check"></i>
                    </div>
                    <div>
                        <div class="flex items-baseline gap-2">
                            <span class="text-2xl font-bold text-slate-900">@Model.CompletedSessionsCount</span>
                            <span class="text-xs font-bold text-slate-800">Completed Sessions</span>
                        </div>
                        <p class="text-[10px] text-slate-400 font-medium mt-0.5">
                            @(Model.LastCompletedSessionDate.HasValue ? $"Last: {Model.LastCompletedSessionDate:MMM d, yyyy}" : "No sessions yet")
                        </p>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-slate-800">Recent Cases</h3>
                    <a href="@Url.Action("MyCases", "Cases")" class="text-[11px] font-bold text-[#2563EB] hover:underline flex items-center gap-1">
                        View all <i class="fa-solid fa-chevron-right text-[9px]"></i>
                    </a>
                </div>

                <div class="space-y-3">
                    @if (Model.RecentCases != null && Model.RecentCases.Any())
                    {
                        foreach (var c in Model.RecentCases)
                        {
                            string badgeClass = c.status switch
                            {
                                DentLink.DataAccessLayer.Enums.Status.Pending => "bg-amber-50 text-amber-600",
                                DentLink.DataAccessLayer.Enums.Status.Active => "bg-blue-50 text-blue-600",
                                DentLink.DataAccessLayer.Enums.Status.Completed => "bg-emerald-50 text-emerald-600",
                                _ => "bg-slate-50 text-slate-600"
                            };
                            <div class="bg-white border border-slate-100 rounded-2xl p-4 flex items-center justify-between shadow-sm hover:shadow-md transition">
                                <div class="flex items-center gap-4">
                                    <img src="@(string.IsNullOrEmpty(c.ImageUrl) ? "/assets/images/default-case.jpg" : c.ImageUrl)"
                                         alt="Case" class="w-12 h-12 rounded-xl object-cover border border-slate-100">
                                    <div>
                                        <h4 class="text-sm font-bold text-slate-800">@c.Typies</h4>
                                        <p class="text-[11px] text-slate-400 font-medium mt-0.5">@c.Description</p>
                                        <span class="text-[10px] text-slate-400 font-medium block mt-1">@c.CreatedAt.ToString("MMM d, yyyy")</span>
                                    </div>
                                </div>
                                <div class="text-right space-y-2">
                                    <span class="text-[10px] font-bold @badgeClass px-2.5 py-0.5 rounded-full capitalize">
                                        @c.status
                                    </span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-400 text-center py-8">No cases yet.</p>
                    }
                </div>
            </div>

        </main>
    </div>

</body>
</html>