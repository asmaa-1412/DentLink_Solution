    <!-- JAVASCRIPT LIVE FILTERING LOGIC -->
    <script>
        function filterPatients() {
            const searchVal = document.getElementById('patientSearchInput').value.toLowerCase();
            const locationVal = document.getElementById('patientLocationFilter').value;
            const rows = document.querySelectorAll('.patient-row');
            const emptyState = document.getElementById('patientEmptyState');
            
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name').toLowerCase();
                const email = row.getAttribute('data-email').toLowerCase();
                const loc = row.getAttribute('data-location');

                const matchesSearch = name.includes(searchVal) || email.includes(searchVal);
                const matchesLocation = locationVal === "" || loc === locationVal;

                if (matchesSearch && matchesLocation) {
                    row.classList.remove('hidden');
                    visibleCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            // Update Counter Top Header Text
            document.getElementById('totalPatientsCounter').innerText = `${visibleCount} total`;

            if (visibleCount === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
        }
    </script>
