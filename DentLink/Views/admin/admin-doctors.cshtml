<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Registered Doctors</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Font: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

    <!-- SIDEBAR (نفس الهوية الأصلية للأدمن) -->
    <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
        <div class="space-y-7">
            <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2">
                
                 <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
            </div>
            
            <div class="px-2">
                <span class="text-[10px] tracking-wider font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded uppercase">Administrator</span>
            </div>

            <nav class="space-y-1">
                <a href="admin-dashboard.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-table-columns text-sm w-5"></i><span>Dashboard</span>
                </a>
                <a href="doctor-approvals.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-user-check text-sm w-5"></i><span>Doctor Approvals</span>
                </a>
                <a href="admin-doctors.html" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                    <i class="fa-solid fa-user-doctor text-sm w-5"></i><span>Verified Doctors</span>
                </a>
                <a href="admin-patients.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                    <i class="fa-solid fa-users text-sm w-5"></i><span>Patients</span>
                </a>
                <a href="admin-cases.html" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                    <i class="fa-regular fa-folder-open text-sm w-5"></i><span>Cases</span>
                </a>
            </nav>
        </div>

        <div class="border-t border-slate-100 pt-4 space-y-3">
            <div class="flex items-center gap-2 px-2">
                <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-600"><i class="fa-solid fa-user-tie"></i></div>
                <div>
                    <h4 class="text-xs font-bold text-slate-800">Dr. Admin</h4>
                    <p class="text-[10px] text-slate-400">Administrator</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Header -->
        <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
            <h2 class="text-sm font-bold text-slate-800">Verified Doctors</h2>
            <div class="flex items-center gap-4">
                <span class="text-xs font-semibold bg-slate-100 px-3 py-1 rounded-full text-slate-600" id="totalCounter">Total: 3</span>
            </div>
        </header>

        <!-- Main Container -->
        <main class="flex-1 px-8 py-8 space-y-6 max-w-7xl w-full">
            <div>
                <h1 class="text-xl font-bold text-slate-900">Registered Dental Students</h1>
                <p class="text-xs text-slate-400 font-medium mt-1">Manage and monitor all verified dental students on the platform.</p>
            </div>

            <!-- 🔍 ADVANCED SEARCH & FILTER BAR (الفكرة المقترحة) -->
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Search Box -->
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="searchInput" oninput="filterData()" placeholder="Search by name or ID..." class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 focus:border-blue-500 focus:bg-white rounded-xl text-xs outline-none transition">
                </div>
                <!-- University Filter -->
                <div class="relative">
                    <i class="fa-solid fa-graduation-cap absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <select id="uniFilter" onchange="filterData()" class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 focus:border-blue-500 focus:bg-white rounded-xl text-xs outline-none transition appearance-none">
                        <option value="">All Universities</option>
                        <option value="Cairo University">Cairo University</option>
                        <option value="Ain Shams University">Ain Shams University</option>
                        <option value="Alexandria University">Alexandria University</option>
                    </select>
                </div>
                <!-- Location Filter -->
                <div class="relative">
                    <i class="fa-solid fa-location-dot absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <select id="locationFilter" onchange="filterData()" class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 focus:border-blue-500 focus:bg-white rounded-xl text-xs outline-none transition appearance-none">
                        <option value="">All Locations</option>
                        <option value="Maadi, Cairo">Maadi, Cairo</option>
                        <option value="Nasr City, Cairo">Nasr City, Cairo</option>
                        <option value="Heliopolis, Cairo">Heliopolis, Cairo</option>
                    </select>
                </div>
            </div>

            <!-- 📊 DATA TABLE (بنفس روح تصميم صفحة الـ Patients بالظبط) -->
            <div class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/75 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                            <th class="py-3.5 px-6">Doctor / Student</th>
                            <th class="py-3.5 px-6">University</th>
                            <th class="py-3.5 px-6">Location</th>
                            <th class="py-3.5 px-6">Year</th>
                        </tr>
                    </thead>
                    <tbody id="doctorsTableBody" class="divide-y divide-slate-50 text-xs font-medium text-slate-700">
                        <!-- Row 1 -->
                        <tr class="doctor-row hover:bg-slate-50/50 transition" data-name="Omar Khaled" data-id="101" data-uni="Cairo University" data-location="Nasr City, Cairo">
                            <td class="py-4 px-6 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-50 text-[#2563EB] font-bold flex items-center justify-center text-xs">OK</div>
                                <div>
                                    <span class="block font-bold text-slate-900">Omar Khaled</span>
                                    <span class="block text-[10px] text-slate-400 font-normal">ID: #101</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-slate-500">Cairo University</td>
                            <td class="py-4 px-6 text-slate-500"><i class="fa-solid fa-location-dot text-slate-300 mr-1.5"></i>Nasr City, Cairo</td>
                            <td class="py-4 px-6"><span class="bg-blue-50 text-blue-700 font-bold px-2.5 py-0.5 rounded text-[10px]">4th Year</span></td>
                        </tr>
                        <!-- Row 2 -->
                        <tr class="doctor-row hover:bg-slate-50/50 transition" data-name="Nour Ibrahim" data-id="102" data-uni="Ain Shams University" data-location="Maadi, Cairo">
                            <td class="py-4 px-6 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-50 text-[#2563EB] font-bold flex items-center justify-center text-xs">NI</div>
                                <div>
                                    <span class="block font-bold text-slate-900">Nour Ibrahim</span>
                                    <span class="block text-[10px] text-slate-400 font-normal">ID: #102</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-slate-500">Ain Shams University</td>
                            <td class="py-4 px-6 text-slate-500"><i class="fa-solid fa-location-dot text-slate-300 mr-1.5"></i>Maadi, Cairo</td>
                            <td class="py-4 px-6"><span class="bg-blue-50 text-blue-700 font-bold px-2.5 py-0.5 rounded text-[10px]">5th Year</span></td>
                        </tr>
                        <!-- Row 3 -->
                        <tr class="doctor-row hover:bg-slate-50/50 transition" data-name="Karim Saad" data-id="103" data-uni="Alexandria University" data-location="Heliopolis, Cairo">
                            <td class="py-4 px-6 flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-50 text-[#2563EB] font-bold flex items-center justify-center text-xs">KS</div>
                                <div>
                                    <span class="block font-bold text-slate-900">Karim Saad</span>
                                    <span class="block text-[10px] text-slate-400 font-normal">ID: #103</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-slate-500">Alexandria University</td>
                            <td class="py-4 px-6 text-slate-500"><i class="fa-solid fa-location-dot text-slate-300 mr-1.5"></i>Heliopolis, Cairo</td>
                            <td class="py-4 px-6"><span class="bg-blue-50 text-blue-700 font-bold px-2.5 py-0.5 rounded text-[10px]">3rd Year</span></td>
                        </tr>
                    </tbody>
                </table>
                <!-- Empty State Block -->
                <div id="emptyState" class="hidden py-12 text-center space-y-2">
                    <i class="fa-regular fa-folder-open text-slate-300 text-3xl"></i>
                    <p class="text-xs font-medium text-slate-400">No doctors match your filtering criteria.</p>
                </div>
            </div>
        </main>
    </div>

    <!-- JAVASCRIPT FILTERING LOGIC -->
    <script>
        function filterData() {
            const searchVal = document.getElementById('searchInput').value.toLowerCase();
            const uniVal = document.getElementById('uniFilter').value;
            const locVal = document.getElementById('locationFilter').value;
            const rows = document.querySelectorAll('.doctor-row');
            const emptyState = document.getElementById('emptyState');
            
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name').toLowerCase();
                const id = row.getAttribute('data-id');
                const uni = row.getAttribute('data-uni');
                const loc = row.getAttribute('data-location');

                const matchesSearch = name.includes(searchVal) || id.includes(searchVal);
                const matchesUni = uniVal === "" || uni === uniVal;
                const matchesLoc = locVal === "" || loc === locVal;

                if (matchesSearch && matchesUni && matchesLoc) {
                    row.classList.remove('hidden');
                    visibleCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            // تحديث العداد العلوي تلقائياً
            document.getElementById('totalCounter').innerText = `Total: ${visibleCount}`;

            // إظهار رسالة عدم وجود نتائج في حال اختفاء كل الصفوف
            if (visibleCount === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }
        }
    </script>
</body>
</html>