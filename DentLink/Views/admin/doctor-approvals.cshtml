@model List<DentLink.DataAccessLayer.Models.Doctor>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Doctor Approvals</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }</style>
    </head>
    <body class="bg-[#F8FAFC] min-h-screen flex antialiased text-[#1E293B]">

        <aside class="w-64 bg-white border-r border-slate-100 flex flex-col justify-between h-screen sticky top-0 px-4 py-6 shrink-0">
            <div class="space-y-7">
                <div class="flex items-center gap-2 text-[#2563EB] font-bold text-xl px-2">
                    <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
                </div>
                <div class="px-2">
                    <span class="text-[10px] tracking-wider font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded uppercase">Administrator</span>
                </div>
                <nav class="space-y-1">
                    <a href="@Url.Action("Dashboard", "Admin")" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                        <i class="fa-solid fa-table-columns text-sm w-5"></i><span>Dashboard</span>
                    </a>
                    <a href="@Url.Action("DoctorApprovals", "Admin")" class="flex items-center gap-3 px-3 py-2.5 bg-[#EFF6FF] text-[#2563EB] font-semibold text-xs rounded-xl transition">
                        <i class="fa-solid fa-user-check text-sm w-5"></i><span>Doctor Approvals</span>
                    </a>
                    <a href="@Url.Action("AdminDoctors", "Admin")" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                        <i class="fa-solid fa-user-doctor text-sm w-5"></i><span>Verified Doctors</span>
                    </a>
                    <a href="@Url.Action("AdminPatients", "Admin")" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                        <i class="fa-solid fa-users text-sm w-5"></i><span>Patients</span>
                    </a>
                    <a href="@Url.Action("AdminCases", "Admin")" class="flex items-center gap-3 px-3 py-2.5 text-slate-400 hover:text-[#2563EB] hover:bg-slate-50 font-medium text-xs rounded-xl transition">
                        <i class="fa-regular fa-folder-open text-sm w-5"></i><span>Cases</span>
                    </a>
                </nav>
            </div>

            <div class="border-t border-slate-100 pt-4 space-y-3">
                <div class="flex items-center gap-2 px-2">
                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-600"><i class="fa-solid fa-user-tie"></i></div>
                    <div>
                        <h4 class="text-xs font-bold text-slate-800">@(User.Identity?.Name ?? "Admin")</h4>
                        <p class="text-[10px] text-slate-400">Administrator</p>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="flex items-center gap-3 w-full px-3 py-2 text-slate-400 hover:text-rose-600 font-semibold text-xs rounded-xl transition">
                        <i class="fa-solid fa-arrow-right-from-bracket text-sm w-5"></i><span>Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0">
            <header class="h-16 bg-white border-b border-slate-100 px-8 flex items-center justify-between sticky top-0 z-40">
                <h2 class="text-sm font-bold text-slate-800">Approvals</h2>
            </header>

            <main class="flex-1 px-8 py-8 space-y-6 max-w-7xl w-full">
                <div>
                    <h1 class="text-xl font-bold text-slate-900">Approvals</h1>
                    <p class="text-xs text-slate-400 font-medium mt-1">Review and verify dental student ID cards</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="bg-[#EFFBFA] border border-[#CCF4F0] rounded-2xl p-4 flex items-center gap-3">
                        <div class="bg-[#059669] text-white w-5 h-5 rounded-full flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-check text-[10px]"></i>
                        </div>
                        <p class="text-xs font-semibold text-[#047857]">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (Model != null && Model.Any())
                {
                    <div class="grid md:grid-cols-3 gap-6">
                        @foreach (var d in Model)
                        {
                            var initials = string.Join("", (d.User?.FullName ?? "?").Split(' ').Where(s => s.Length > 0).Select(s => s[0])).ToUpper();
                            <div class="bg-white border border-slate-100 rounded-2xl p-5 shadow-sm space-y-4 flex flex-col justify-between">
                                <div class="space-y-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-sm">@initials</div>
                                        <div>
                                            <h3 class="text-xs font-bold text-slate-800">@d.User?.FullName</h3>
                                            <p class="text-[10px] text-slate-400 font-medium mt-0.5">@d.User?.Email</p>
                                        </div>
                                    </div>

                                    <div class="space-y-2 text-[11px] text-slate-500 font-medium border-t border-slate-50 pt-3">
                                        <div class="flex items-center gap-2"><i class="fa-solid fa-graduation-cap text-slate-400 w-4"></i><span>@d.University</span></div>
                                        <div class="flex items-center gap-2"><i class="fa-solid fa-stethoscope text-slate-400 w-4"></i><span>@d.Department</span></div>
                                        <div class="flex items-center gap-2"><i class="fa-regular fa-calendar text-slate-400 w-4"></i><span>@d.AcademicYear</span></div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(d.IdCardUrl))
                                    {
                                        <a href="@d.IdCardUrl" target="_blank" class="relative rounded-xl overflow-hidden bg-slate-100 h-32 flex items-center justify-center border border-slate-200/60 block">
                                            <div class="absolute inset-0 bg-cover bg-center opacity-90" style="background-image: url('@d.IdCardUrl');"></div>
                                            <span class="absolute bottom-2 left-2 bg-slate-900/70 text-white text-[9px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">Student ID</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="rounded-xl bg-slate-100 h-32 flex items-center justify-center border border-slate-200/60 text-slate-400 text-xs">
                                            No ID uploaded
                                        </div>
                                    }
                                </div>

                                <div class="grid grid-cols-2 gap-3 pt-2">
                                    <form asp-controller="Admin" asp-action="ApproveDoctor" asp-route-id="@d.Id" method="post">
                                        <button type="submit" class="w-full flex items-center justify-center gap-1.5 px-3 py-2 bg-[#2563EB] hover:bg-blue-700 text-white text-xs font-semibold rounded-xl transition shadow-sm">
                                            <i class="fa-regular fa-circle-check"></i><span>Approve</span>
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="RejectDoctor" asp-route-id="@d.Id" method="post" onsubmit="return confirm('Reject and remove this doctor request?');">
                                        <button type="submit" class="w-full flex items-center justify-center gap-1.5 px-3 py-2 bg-white hover:bg-rose-50 border border-slate-200 hover:border-rose-200 text-slate-600 hover:text-rose-600 text-xs font-semibold rounded-xl transition">
                                            <i class="fa-regular fa-circle-xmark"></i><span>Reject</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="bg-white border border-slate-100 rounded-2xl py-16 text-center space-y-2">
                        <i class="fa-regular fa-circle-check text-slate-300 text-3xl"></i>
                        <p class="text-xs font-medium text-slate-400">No pending approvals right now.</p>
                    </div>
                }
            </main>
        </div>
    </body>
</html>