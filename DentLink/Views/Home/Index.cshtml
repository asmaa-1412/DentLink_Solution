            <h3 class="text-xl font-bold text-slate-900 mb-1  text-white">Patient Case Form</h3>
            <p class="text-xs text-slate-400 mb-6  text-white">All fields marked * are required.</p>
            
            <form class="space-y-4 bg-[#0F172A] text-white">
                <div class="grid md:grid-cols-2 gap-4  text-white">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5  text-white">Full Name *</label>
                        <input type="text" placeholder="Ahmed Hassan" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5  text-white">Phone Number *</label>
                        <input type="text" placeholder="+20 100 000 0000" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5  text-white">Email Address *</label>
                    <input type="email" placeholder="ahmed@example.com" class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-500">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1.5  text-white">Dental Issue *</label>
                    <div class="relative">
                        <select class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 appearance-none text-slate-400 focus:outline-none focus:border-blue-500">
