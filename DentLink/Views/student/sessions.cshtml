@model List<DentLink.BusinessLogicLayer.DTOs.Doctordtos.DoctorSessionDto>
@{
    Layout = null;
    var doctorName = ViewBag.DoctorName as string ?? "Student";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sessions - DentLink</title>
    <link rel="stylesheet" href="~/assets/css/student-dashboard.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">
</head>
<body>
    <div class="student-dashboard">
        <aside class="student-sidebar">
            <div class="student-sidebar-header">
                <a href="@Url.Action("Dashboard", "Doctor")" class="student-logo">Dent<span>Link</span></a>
                <span class="student-role-badge">DENTAL STUDENT</span>
            </div>
            <nav class="student-nav">
                <a href="@Url.Action("Dashboard", "Doctor")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    Dashboard
                </a>
                <a href="@Url.Action("AvailableCases", "Doctor")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    Available Cases
                </a>
                <a href="@Url.Action("MyRequests", "Doctor")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    My Requests
                </a>
                <a href="@Url.Action("Sessions", "Doctor")" class="active">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    Sessions
                </a>
                <a href="@Url.Action("Profile", "Doctor")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    Profile
                </a>
            </nav>
            <div class="student-sidebar-footer">
                <div class="student-user-card">
                    <img src="https://i.pravatar.cc/72?img=12" alt="@doctorName" class="student-user-avatar">
                    <div class="student-user-info">
                        <div class="student-user-name">@doctorName</div>
                        <div class="student-user-role">Dental Student</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="student-logout" style="background:none;border:none;width:100%;cursor:pointer;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="student-main">
            <header class="student-topbar">
                <span class="student-topbar-title">Sessions</span>
            </header>

            <div class="student-content">
                <div class="student-page-header">
                    <h1>Sessions</h1>
                    <p>Manage your active and upcoming treatment sessions.</p>
                </div>

                <div class="sessions-list">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var s in Model)
                        {
                            <article class="session-card-full">
                                <div class="session-card-top">
                                    <div class="session-patient">
                                        <img src="https://i.pravatar.cc/72?img=5" alt="@s.PatientName" class="session-patient-avatar">
                                        <div>
                                            <div class="session-patient-name">@s.PatientName</div>
                                            <div class="session-patient-detail">@s.CaseType · @s.SessionStart.ToString("MMM d, yyyy, h:mm tt")</div>
                                        </div>
                                    </div>
                                    @{
                                        string badgeClass = s.Status switch
                                        {
                                            "completed" => "session-badge-completed",
                                            "in progress" => "session-badge-progress",
                                            _ => "session-badge-confirmed"
                                        };
                                    }
                                    <span class="session-badge @badgeClass">@s.Status</span>
                                </div>
                                <div class="session-card-actions">
                                    @if (s.Status == "confirmed")
                                    {
                                        <form asp-controller="Doctor" asp-action="ConfirmArrival" method="post">
                                            <input type="hidden" name="sessionId" value="@s.SessionId" />
                                            <button type="submit" class="session-btn-outline">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                                                Confirm Patient Arrived
                                            </button>
                                        </form>
                                    }
                                    else if (s.Status == "in progress")
                                    {
                                        <form asp-controller="Doctor" asp-action="CompleteSession" method="post">
                                            <input type="hidden" name="sessionId" value="@s.SessionId" />
                                            <button type="submit" class="session-btn-complete">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                                                Complete Session
                                            </button>
                                        </form>
                                        <span class="session-present-badge">Patient present</span>
                                    }
                                    else
                                    {
                                        <span class="session-done-msg">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                            Session completed successfully
                                        </span>
                                    }
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <p style="font-size:12px;color:#94a3b8;">No sessions yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</body>
</html>