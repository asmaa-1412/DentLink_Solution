<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Account Under Review</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#EFF6FF] min-h-screen flex flex-col justify-center items-center p-6 antialiased">

    <div class="max-w-xl w-full mx-auto flex flex-col items-center text-center space-y-8">
        
        <!-- Logo -->
        <div class="flex items-center gap-2 text-[#2563EB] font-bold text-2xl">
            <i class="fa-solid fa-graduation-cap text-3xl"></i>
                <span class="text-black">Dent<span class="text-[#2563EB]">Link</span></span>
        </div>

        <!-- Animated/Circular Pending Indicator Box -->
        <div class="relative w-32 h-32 flex items-center justify-center">
            <!-- Outer dotted/dashed rotating ring styling -->
            <div class="absolute inset-0 border-4 border-dashed border-[#2563EB]/30 rounded-full animate-spin [animation-duration:10s]"></div>
            <!-- Decorative Dots to match Figma image_53c01b.jpg -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-2 h-2 bg-[#2563EB] rounded-full"></div>
            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-2 h-2 bg-[#2563EB] rounded-full"></div>
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-[#2563EB] rounded-full"></div>
            <div class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 bg-[#2563EB] rounded-full"></div>
            
            <!-- Inner Circle with Icon & Text -->
            <div class="w-24 h-24 bg-white rounded-full shadow-md flex flex-col items-center justify-center space-y-1 z-10 border border-slate-100">
                <i class="fa-regular fa-clock text-2xl text-[#2563EB]"></i>
                <span class="text-[10px] font-bold tracking-wider text-[#2563EB] uppercase">Pending</span>
            </div>
        </div>

        <!-- Main Heading & Paragraph Description -->
        <div class="space-y-3">
            <h1 class="text-2xl md:text-3xl font-bold text-[#0F172A]">Your account is under review</h1>
            <p class="text-sm md:text-base text-slate-500 max-w-md mx-auto font-medium leading-relaxed">
                Admin is verifying your student ID card and university enrollment.
            </p>
            <p class="text-xs text-slate-400 max-w-xs mx-auto">
                This usually takes <span class="font-semibold text-slate-600">24–48 hours</span>. You will receive an email once your account is approved.
            </p>
        </div>

        <!-- Timeline Status Card -->
        <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-sm w-full max-w-md text-left space-y-5">
            
            <!-- Step 1: Account Created (Completed) -->
            <div class="flex items-center gap-4">
                <div class="w-6 h-6 rounded-full bg-[#DEF7EC] text-[#03543F] flex items-center justify-center text-xs">
                    <i class="fa-solid fa-check"></i>
                </div>
                <span class="text-sm font-semibold text-[#03543F]">Account Created</span>
            </div>

            <!-- Step 2: Documents Submitted (Completed) -->
            <div class="flex items-center gap-4">
                <div class="w-6 h-6 rounded-full bg-[#DEF7EC] text-[#03543F] flex items-center justify-center text-xs">
                    <i class="fa-solid fa-check"></i>
                </div>
                <span class="text-sm font-semibold text-[#03543F]">Documents Submitted</span>
            </div>

            <!-- Step 3: Admin Verification (Current Active) -->
            <div class="flex items-center gap-4">
                <div class="w-6 h-6 rounded-full bg-[#EFF6FF] text-[#2563EB] border-2 border-[#2563EB] flex items-center justify-center relative">
                    <!-- Inner active dot inside ring -->
                    <div class="w-2 h-2 bg-[#2563EB] rounded-full"></div>
                </div>
                <span class="text-sm font-bold text-[#2563EB]">Admin Verification</span>
            </div>

            <!-- Step 4: Account Approved (Pending/Locked) -->
            <div class="flex items-center gap-4 opacity-40">
                <div class="w-6 h-6 rounded-full bg-slate-100 text-slate-400 border-2 border-slate-200 flex items-center justify-center"></div>
                <span class="text-sm font-medium text-slate-500">Account Approved</span>
            </div>

        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center gap-4 pt-4 w-full justify-center">
            <button onclick="alert('Redirecting to preview layout...')" class="w-full sm:w-auto bg-[#2563EB] text-white px-6 py-2.5 rounded-xl font-semibold text-xs hover:bg-blue-700 transition shadow-sm">
                Preview Dashboard
            </button>
            <button onclick="window.location.href='../index.html'" class="w-full sm:w-auto bg-white border border-slate-200 text-slate-600 px-6 py-2.5 rounded-xl font-semibold text-xs hover:bg-slate-50 hover:text-slate-900 transition">
                Back to Home
            </button>
        </div>

    </div>

</body>
</html>