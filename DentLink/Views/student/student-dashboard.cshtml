<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - DentLink</title>
  <link rel="stylesheet" href="../assets/css/student-dashboard.css">
  <link rel="stylesheet" href="../assets/css/responsive.css">
</head>
<body>
  <div class="student-dashboard">
    <!-- Sidebar -->
    <aside class="student-sidebar">
      <div class="student-sidebar-header">
        <a href="student-dashboard.html" class="student-logo">
          Dent<span>Link</span> 
        </a>
        <span class="student-role-badge">DENTAL STUDENT</span>
      </div>

      <nav class="student-nav">
        <a href="dashboard.html" class="active">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Dashboard
        </a>
        <a href="available-cases.html">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          Available Cases
        </a>
        <a href="my-requests.html">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          My Requests
        </a>
        <a href="sessions.html">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Sessions
        </a>
        <a href="profile.html">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Profile
        </a>
      </nav>

      <div class="student-sidebar-footer">
        <div class="student-user-card">
          <img src="https://i.pravatar.cc/72?img=12" alt="Omar Khaled" class="student-user-avatar">
          <div class="student-user-info">
            <div class="student-user-name">Omar Khaled</div>
            <div class="student-user-role">Dental Student</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <a href="../auth/login.html" class="student-logout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Logout
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="student-main">
      <header class="student-topbar">
        <span class="student-topbar-title">Dashboard</span>
        <div class="student-topbar-actions">
          <button class="student-notif-btn" aria-label="Notifications">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
            <span class="student-notif-dot"></span>
          </button>
          <img src="https://i.pravatar.cc/72?img=12" alt="Omar Khaled" class="student-topbar-avatar">
        </div>
      </header>

      <div class="student-content">
        <div class="student-welcome">
          <h1>Welcome back, Omar </h1>
          <p>Here is your clinical activity overview.</p>
        </div>

        <!-- Stats -->
        <div class="student-stats">
          <div class="student-stat-card">
            <div class="student-stat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
            </div>
            <div>
              <div class="student-stat-value">12</div>
              <div class="student-stat-label">Available Cases</div>
              <div class="student-stat-sub">8 matching your specialization</div>
            </div>
          </div>

          <div class="student-stat-card">
            <div class="student-stat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
              <div class="student-stat-value">2</div>
              <div class="student-stat-label">Accepted Requests</div>
              <div class="student-stat-sub">1 session upcoming</div>
            </div>
          </div>

          <div class="student-stat-card">
            <div class="student-stat-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <div class="student-stat-value">5</div>
              <div class="student-stat-label">Completed Sessions</div>
              <div class="student-stat-sub">Last: Jun 18, 2024</div>
            </div>
          </div>
        </div>

        <!-- Activity & Sessions -->
        <div class="student-grid">
          <div class="student-panel">
            <h2 class="student-panel-title">Recent Activity</h2>
            <ul class="student-activity-list">
              <li class="student-activity-item">
                <span class="student-activity-dot green"></span>
                <span class="student-activity-text">Your request for Layla H. was accepted</span>
                <span class="student-activity-time">2h ago</span>
              </li>
              <li class="student-activity-item">
                <span class="student-activity-dot blue"></span>
                <span class="student-activity-text">New Filling case in Nasr City posted</span>
                <span class="student-activity-time">4h ago</span>
              </li>
              <li class="student-activity-item">
                <span class="student-activity-dot gray"></span>
                <span class="student-activity-text">Session with Ahmed K. completed</span>
                <span class="student-activity-time">Jun 18</span>
              </li>
            </ul>
          </div>

          <div class="student-panel">
            <h2 class="student-panel-title">Upcoming Sessions</h2>
            <div class="student-session-card">
              <div class="student-session-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div class="student-session-info">
                <div class="student-session-name">Sara Mohamed — Filling</div>
                <div class="student-session-date">Jun 22, 2024, 10:00 AM</div>
              </div>
              <span class="student-badge student-badge-confirmed">confirmed</span>
            </div>
            <div class="student-session-card">
              <div class="student-session-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div class="student-session-info">
                <div class="student-session-name">Ahmed Karim — Extraction</div>
                <div class="student-session-date">Jun 28, 2024, 2:00 PM</div>
              </div>
              <span class="student-badge student-badge-progress">in-progress</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="../assets/js/main.js"></script>
</body>
</html>