@model IEnumerable<DentLink.DataAccessLayer.Models.Case>

@{
    ViewData["Title"] = "Available Cases";
    string currentType = ViewBag.CurrentType ?? "All";
}

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

            <div class="mb-4">
                <h2 class="fw-bold text-dark mb-1">Available Cases</h2>
                <p class="text-muted small">Browse open dental cases and send your request</p>
            </div>

            <form asp-controller="Doctor" asp-action="AvailableCases" method="get" id="filterForm" class="row g-3 align-items-center mb-4">

                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group bg-white rounded-pill shadow-sm px-3 py-1 border">
                        <span class="input-group-text bg-transparent border-0 text-muted">🔍</span>
                        <input type="text" name="searchQuery" value="@ViewBag.CurrentSearch" class="form-control bg-transparent border-0 small" placeholder="Search by type, description..." onkeyup="delaySubmit()">
                    </div>
                </div>

                <input type="hidden" name="selectedType" id="selectedTypeField" value="@currentType" />

                <div class="col-12 col-md-7 col-lg-8">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="text-muted small me-2"><i class="bi bi-funnel"></i></span>

                        @{
                            var categories = new[] { "All", "Filling", "Extraction", "Cleaning", "Root Canal", "Orthodontics", "Whitening" };
                            foreach (var category in categories)
                            {
                                var isActive = currentType == category;
                                <button type="button" onclick="filterByCategory('@category')"
                                        class="btn btn-sm rounded-pill px-3 py-1.5 fw-semibold transition-all @(isActive ? "btn-primary shadow" : "btn-light border text-secondary")">
                                    @category
                                </button>
                            }
                        }
                    </div>
                </div>
            </form>

            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white hover-shadow transition-all">

                                @* 🔴 هنا تم تصليح الـ Razor Syntax بإضافة علامات الـ @ لتقسيم الصور أوتوماتيكياً حسب نوع الحالة *@
                                <div style="height: 180px;">
                                    @if (item.Types == "Filling")
                                    {
                                        <div class="w-100 h-100" style="background-image: url('https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=500'); background-size: cover; background-position: center;"></div>
                                    }
                                    else if (item.Types == "Extraction")
                                    {
                                        <div class="w-100 h-100" style="background-image: url('https://images.unsplash.com/photo-1606811971618-4486d14f3f99?w=500'); background-size: cover; background-position: center;"></div>
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100" style="background: url('https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=500') center/cover;"></div>
                                    }
                                </div>

                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1.5 rounded-pill fw-bold">@item.Type</span>
                                        <small class="text-muted text-uppercase" style="font-size: 0.75rem;">@item.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </div>

                                    <p class="text-muted small mb-2"><span class="text-secondary">📍</span> Cairo, Egypt</p>
                                    <p class="card-text text-secondary small mb-4 text-truncate-2" style="height: 40px;">
                                        @(item.Description ?? "No description available for this dental case request.")
                                    </p>

                                    <div class="row g-2 pt-2 border-top">
                                        <div class="col-6">
                                            <button type="button" class="btn btn-outline-light border w-100 text-dark fw-semibold rounded-pill btn-sm py-2">👁️ Details</button>
                                        </div>
                                        <div class="col-6">
                                            <form asp-controller="Doctor" asp-action="SendRequest" method="post">
                                                <input type="hidden" name="caseId" value="@item.Id" />
                                                <input type="hidden" name="transportCost" value="50" />
                                                <input type="hidden" name="transportCost" value="50" />
                                                <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill btn-sm py-2">Send Request</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-muted fs-5">No available cases match your search or filter criteria.</p>
                        <a asp-controller="Doctor" asp-action="AvailableCases" class="btn btn-primary btn-sm rounded-pill mt-2">Reset Filters</a>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<script>
    function filterByCategory(category) {
        document.getElementById('selectedTypeField').value = category;
        document.getElementById('filterForm').submit();
    }

    let timeout = null;
    function delaySubmit() {
        clearTimeout(timeout);
        timeout = setTimeout(function () {
            document.getElementById('filterForm').submit();
        }, 700);
    }
</script>

<style>
    .transition-all {
        transition: all 0.25s ease-in-out;
    }

    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08) !important;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>