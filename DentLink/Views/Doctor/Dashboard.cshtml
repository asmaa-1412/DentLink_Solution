@model IEnumerable<DentLink.DataAccessLayer.Models.Session>

@{
    ViewData["Title"] = "Dashboard";
    var recentRequests = ViewBag.RecentRequests as List<DentLink.DataAccessLayer.Models.SendCaseRequest>;
}

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

            <div class="mb-4">
                <h2 class="fw-bold text-dark mb-1">
                    Welcome back,
                    <a asp-controller="Doctor" asp-action="Profile" class="text-primary text-decoration-none hover-underline">
                        @ViewBag.DoctorName 👋
                    </a>
                </h2>
                <p class="text-muted small">Here is your clinical activity overview.</p>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary fs-4">🧳</div>
                            <div>
                                <h3 class="fw-bold mb-0">@ViewBag.AvailableCasesCount</h3>
                                <small class="text-muted">Available Cases</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success bg-opacity-10 p-3 rounded-3 text-success fs-4">✅</div>
                            <div>
                                <h3 class="fw-bold mb-0">@ViewBag.AcceptedRequestsCount</h3>
                                <small class="text-muted">Accepted Requests</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-info bg-opacity-10 p-3 rounded-3 text-info fs-4">📅</div>
                            <div>
                                <h3 class="fw-bold mb-0">@ViewBag.CompletedSessionsCount</h3>
                                <small class="text-muted">Completed Sessions</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-dark mb-0">Recent Activity</h5>
                            <a asp-controller="Doctor" asp-action="AvailableCases" class="btn btn-sm btn-light text-primary fw-semibold rounded-pill px-3">View All</a>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @if (recentRequests != null && recentRequests.Any())
                            {
                                foreach (var request in recentRequests)
                                {
                                    <a asp-controller="Doctor" asp-action="AvailableCases" class="d-flex align-items-start gap-3 p-2 rounded-3 text-decoration-none text-dark hover-bg-light">
                                        <div class="text-primary fs-5">🔹</div>
                                        <div>
                                            <p class="mb-0 fw-medium small">Your request for case <strong>@request.CaseRequest?.Case?.Type</strong> is <span class="badge bg-opacity-10 text-primary bg-primary">@request.CaseRequest?.Status</span></p>
                                            <span class="text-muted small" style="font-size: 0.75rem;">Submitted Recently</span>
                                        </div>
                                    </a>
                                }
                            }
                            else
                            {
                                <p class="text-muted small my-3 text-center">No recent activity found.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-dark mb-0">Upcoming Sessions</h5>
                            <a asp-controller="Doctor" asp-action="Sessions" class="btn btn-sm btn-light text-primary fw-semibold rounded-pill px-3">Manage</a>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var session in Model)
                                {
                                    <a asp-controller="Doctor" asp-action="Sessions" class="d-flex align-items-center justify-content-between p-3 rounded-3 text-decoration-none text-dark border hover-border-primary" style="background-color: #fafbfc;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3 fs-5">🗓️</div>
                                            <div>
                                                <h6 class="fw-bold mb-0 small">@session.CaseRequest?.Case?.Patient?.FullName — @session.CaseRequest?.Case?.Type</h6>
                                                <span class="text-muted small" style="font-size: 0.75rem;">@session.SessionStart.ToString("MMM dd, yyyy, hh:mm tt")</span>
                                            </div>
                                        </div>
                                        <span class="badge bg-primary-subtle text-primary px-3 py-1.5 rounded-pill fw-bold small">
                                            @session.Status
                                        </span>
                                    </a>
                                }
                            }
                            else
                            {
                                <p class="text-muted small my-3 text-center">No upcoming sessions scheduled.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .hover-underline:hover {
        text-decoration: underline !important;
    }

    .hover-bg-light:hover {
        background-color: #f8f9fa;
    }

    .hover-border-primary {
        transition: border-color 0.2s;
    }

        .hover-border-primary:hover {
            border-color: #0d6efd !important;
            background-color: #fff !important;
        }
</style>