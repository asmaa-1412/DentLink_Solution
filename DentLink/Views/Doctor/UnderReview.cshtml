@{
    ViewData["Title"] = "Account Under Review";
}

<div class="container-fluid py-5 d-flex align-items-center justify-content-center" style="background-color: #f4f7fc; min-height: 90vh;">
    <div class="text-center" style="max-width: 550px;">

        <div class="position-relative d-inline-block mb-4">
            <div class="spinner-border text-primary" role="status" style="width: 100px; height: 100px; border-width: 3px; animation-duration: 3s;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="position-absolute top-50 start-50 translate-middle d-flex flex-column align-items-center">
                <span class="fs-4 text-primary">🕒</span>
                <span class="fw-bold text-primary" style="font-size: 0.7rem; letter-spacing: 1px;">PENDING</span>
            </div>
        </div>

        <h2 class="fw-bold text-dark mb-3" style="font-size: 2rem;">Your account is under review</h2>
        <p class="text-secondary px-3 mb-2" style="font-size: 1.05rem;">
            Admin is verifying your student ID card and university enrollment.
        </p>
        <p class="text-muted small mb-5">
            This usually takes <strong class="text-dark">24-48 hours</strong>. You will receive an email once your account is approved.
        </p>

        <div class="card border-0 shadow-sm rounded-4 p-4 text-start bg-white mb-5 mx-auto" style="max-width: 400px;">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="text-success fs-5">✨</span>
                <span class="fw-semibold text-success">Account Created</span>
            </div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="text-success fs-5">✨</span>
                <span class="fw-semibold text-success">Documents Submitted</span>
            </div>
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="text-primary fs-5">🔵</span>
                <span class="fw-bold text-primary">Admin Verification</span>
            </div>
            <div class="d-flex align-items-center gap-3 opacity-50">
                <span class="text-secondary fs-5">⚪</span>
                <span class="fw-semibold text-secondary">Account Approved</span>
            </div>
        </div>

        <div class="d-flex justify-content-center align-items-center gap-3">
            <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-primary fw-bold px-4 py-2.5 rounded-pill shadow-sm" style="background-color: #0d6efd; border: none;">
                Preview Dashboard
            </a>

            <a asp-controller="Home" asp-action="Index" class="btn btn-light border fw-semibold px-4 py-2.5 rounded-pill text-secondary bg-white">
                Back to Home
            </a>
        </div>

    </div>
</div>