@model IEnumerable<DentLink.DataAccessLayer.Models.Session>
@{
    ViewData["Title"] = "Sessions";
}

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">

            <div class="mb-4">
                <h2 class="fw-bold text-dark mb-1">Sessions</h2>
                <p class="text-muted small">Manage your active and upcoming treatment sessions</p>
            </div>

            <div class="d-flex flex-column gap-3">
                @if (Model != null && Model.Any())
                {
                    foreach (var session in Model)
                    {
                        var patientName = session.CaseRequest?.Case?.Patient?.FullName ?? "Unknown Patient";
                        var caseType = session.CaseRequest?.Case?.Typies ?? "General Procedure"; 
                        var sessionDate = session.SessionStart.ToString("MMM dd, yyyy · h:mm tt"); 
                        var status = session.PatientArrived ? "in progress" : "confirmed";

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white position-relative hover-shadow transition-all">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                                <div class="d-flex align-items-center gap-3">
                                    <div class="position-relative">
                                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100"
                                             class="rounded-circle border" style="width: 55px; height: 55px; object-fit: cover;" alt="Patient">
                                    </div>
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">@patientName</h5>
                                        <p class="text-muted small mb-0">
                                            <span class="text-primary fw-medium">@caseType</span> &middot; @sessionDate
                                        </p>
                                    </div>
                                </div>

                                <div>
                                    @if (status == "confirmed")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1.5 fw-semibold small">confirmed</span>
                                    }
                                    else if (status == "in progress")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1.5 fw-semibold small" style="color: #9b51e0 !important; background-color: rgba(155, 81, 224, 0.1) !important;">in progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-semibold small">@status</span>
                                    }
                                </div>

                            </div>

                            @if (status != "completed")
                            {
                                <hr class="text-muted opacity-25 my-3">
                            }

                            <div class="d-flex flex-wrap gap-2">
                                @if (status == "confirmed")
                                {
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-4 py-2 fw-semibold" style="font-size: 0.85rem;">
                                        ✔ Confirm Patient Arrived
                                    </button>
                                }
                                else if (status == "in progress")
                                {
                                    <button class="btn btn-success btn-sm rounded-pill px-4 py-2 fw-semibold text-white me-2" style="font-size: 0.85rem; background-color: #00b074; border: none;">
                                        ✔ Complete Session
                                    </button>
                                }
                                else if (status == "completed")
                                {
                                    <div class="text-success small fw-semibold d-flex align-items-center gap-1 mt-1">
                                        <span>✔</span> Session completed successfully
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-dashed">
                        <div class="fs-1 mb-2">📅</div>
                        <p class="text-muted mb-0 fw-medium">No dental sessions scheduled yet.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<style>
    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 .4rem 1rem rgba(0,0,0,.05) !important;
    }

    .border-dashed {
        border-style: dashed !important;
        border-width: 2px !important;
        border-color: #dee2e6 !important;
    }
</style>