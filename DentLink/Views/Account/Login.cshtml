@model DentLink.PresentionLayer.Models.LoginViewModel
@{
    ViewData["Title"] = "DentLink - Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DentLink - Sign In</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-white text-[#1E293B] antialiased">
    <div class="min-h-screen w-full flex flex-col md:flex-row bg-white overflow-hidden">

        <div class="relative w-full md:w-[50%] bg-cover bg-center min-h-[350px] md:min-h-screen flex flex-col justify-between p-8 md:p-16 text-white"
             style="background-image: url('https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1200&q=80');">
            <div class="absolute inset-0 bg-gradient-to-b from-[#2563EB]/90 to-[#1D4ED8]/95 z-0"></div>

            <a asp-controller="Home" asp-action="Index" class="relative z-10 flex items-center gap-2 text-white font-bold text-2xl cursor-pointer">
                <span class="text-white">DentLink</span>
            </a>

            <div class="relative z-10 max-w-md my-auto pt-12 pb-12">
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">Better dental care starts here.</h2>
                <p class="text-blue-100 text-sm md:text-base mt-4 font-normal opacity-90 leading-relaxed">
                    Connect with verified dental students for affordable, supervised treatment across Egypt.
                </p>
            </div>
        </div>

        <div class="w-full md:w-[50%] bg-white flex flex-col justify-center px-6 sm:px-12 md:px-20 lg:px-24 py-12 relative overflow-y-auto">
            <div class="md:absolute md:top-12 md:left-20 lg:left-24 mb-8 md:mb-0">
                <a asp-controller="Home" asp-action="Index" class="text-slate-500 hover:text-[#2563EB] text-sm font-medium flex items-center gap-2 transition">
                    <i class="fa-solid fa-arrow-left text-xs"></i> Back to home
                </a>
            </div>

            <div class="max-w-md w-full mx-auto space-y-6">
                <div>
                    <h1 class="text-3xl font-bold text-slate-900 leading-tight">Welcome back</h1>
                    <p class="text-sm text-slate-500 mt-1">
                        Sign in to your <span class="text-[#2563EB] font-medium">DentLink</span> account
                    </p>
                </div>

                <div asp-validation-summary="All" class="text-red-600 text-sm"></div>

                <form class="space-y-4" asp-controller="Account" asp-action="Login" method="post">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address</label>
                        <input asp-for="Email" id="login-email" placeholder="you@example.com"
                               class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:border-blue-500 focus:bg-white transition">
                        <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-1.5">
                            <label class="block text-xs font-bold text-slate-700">Password</label>
                            <a href="#" class="text-xs text-[#2563EB] font-semibold hover:underline">Forgot password?</a>
                        </div>
                        <div class="relative">
                            <input asp-for="Password" id="login-password" placeholder="••••••••"
                                   class="w-full text-sm bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 pr-10 focus:outline-none focus:border-blue-500 focus:bg-white transition">
                            <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3.5 top-3.5 text-slate-400 hover:text-slate-600">
                                <i id="password-eye-icon" class="fa-regular fa-eye-slash text-sm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-600 text-xs"></span>
                    </div>

                    <button type="submit" class="w-full bg-[#2563EB] text-white py-3.5 rounded-xl font-semibold text-sm hover:bg-blue-700 transition duration-200 shadow-md shadow-blue-100 mt-2">
                        Sign In
                    </button>

                    <div class="text-center mt-6">
                        <p class="text-center text-xs text-slate-500">
                            Don't have an account?
                            <a asp-controller="Account" asp-action="RoleSelection" class="text-[#2563EB] font-semibold hover:underline">Create account</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
        const passwordInput = document.getElementById('login-password');
        const eyeIcon = document.getElementById('password-eye-icon');
        if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
        } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
        }
        }
    </script>
</body>
</html>