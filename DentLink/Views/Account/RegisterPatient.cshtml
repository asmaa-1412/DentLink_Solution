@model DentLink.PresentionLayer.Models.PatientRegisterViewModel
@{
    ViewData["Title"] = "Create Account - DentLink";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - DentLink</title>
    <link rel="stylesheet" href="~/assets/css/auth.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">
</head>
<body>
    <div class="auth-split">
        <aside class="auth-split-brand">
            <a asp-controller="Home" asp-action="Index" class="auth-brand-logo">DentLink</a>
            <div class="auth-brand-content">
                <h1>Better dental care starts here.</h1>
                <p>Connect with verified dental students for affordable, supervised treatment across Egypt.</p>
            </div>
        </aside>

        <main class="auth-split-form">
            <div class="auth-form-wrapper">
                <a asp-controller="Home" asp-action="Index" class="auth-back-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
                    Back to home
                </a>

                <div class="auth-form-header">
                    <h2>Create your account</h2>
                    <p>Join DentLink as a patient</p>
                </div>

                <form class="auth-form" asp-controller="Account" asp-action="RegisterPatient" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Name">Name</label>
                        <input asp-for="Name" id="name" placeholder="Full name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email Address</label>
                        <input asp-for="Email" id="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Age">Age</label>
                        <input asp-for="Age" id="age" placeholder="e.g. 28" min="1" max="120" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <div class="auth-form-row">
                            <div class="form-group">
                                <label asp-for="Governorate" class="sr-only">Governorate</label>
                                <select asp-for="Governorate" id="governorate">
                                    <option value="" disabled selected>Select governorate</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="City" class="sr-only">City</label>
                                <select asp-for="City" id="city" disabled>
                                    <option value="" disabled selected>Select city</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Phone">Phone Number</label>
                        <input asp-for="Phone" id="phone" placeholder="e.g. 01012345678" pattern="01[0-9]{9}" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Create Password</label>
                        <div class="password-field">
                            <input asp-for="Password" id="password" placeholder="••••••••" />
                            <button type="button" class="password-toggle" data-target="password" aria-label="Toggle password visibility">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <div class="password-field">
                            <input asp-for="ConfirmPassword" id="confirmPassword" placeholder="••••••••" />
                            <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Toggle password visibility">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="auth-submit-btn">Create Account</button>
                </form>

                <p class="auth-form-footer">
                    Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
                </p>
            </div>
        </main>
    </div>

    <script src="~/assets/js/egypt-locations.js"></script>
    <script src="~/assets/js/auth.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
        initEgyptLocationSelects('governorate', 'city');
        });
    </script>
</body>
</html>